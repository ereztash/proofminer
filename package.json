{
  "name": "proofminer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Evidence-grounded authority building: mine the proof you already hold, measure the gap between what you did and what the world sees, and close it one move at a time.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "smoke:prod": "npx -p @playwright/test@1.54.2 playwright test tests/e2e/prod-smoke.spec.mjs --reporter=line",
    "corpus:hebrew-orgs": "node scripts/hebrew-org-corpus.mjs",
    "measure:hebrew-orgs": "node scripts/hebrew-org-corpus.mjs --verify && node scripts/measure-hebrew-orgs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
